{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "backend/.venv/Scripts/python.exe",
      "runtimeArgs": [
        "-m",
        "uvicorn",
        "lunar_skyline.app:app",
        "--app-dir",
        "backend",
        "--port",
        "8000"
      ],
      "port": 8000
    },
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "frontend",
        "run",
        "dev",
        "--",
        "--port",
        "5173",
        "--strictPort"
      ],
      "port": 5173
    },
    {
      "name": "backend-macos",
      "runtimeExecutable": "backend/.venv/bin/python",
      "runtimeArgs": [
        "-m",
        "uvicorn",
        "lunar_skyline.app:app",
        "--app-dir",
        "backend",
        "--port",
        "8000"
      ],
      "port": 8000
    },
    {
      "name": "frontend-alt",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "frontend",
        "run",
        "dev",
        "--",
        "--port",
        "5175",
        "--strictPort"
      ],
      "port": 5175
    },
    {
      "name": "frontend-alt-8002",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "frontend",
        "run",
        "dev",
        "--",
        "--port",
        "5176",
        "--strictPort"
      ],
      "env": {
        "LUNAR_API_PROXY": "http://127.0.0.1:8002"
      },
      "port": 5176
    }
  ]
}